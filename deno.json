  "publish": {
    "include": ["src", "mod.ts", "deno.json", "LICENSE", "README.md"],
    "exclude": ["tests"]
  },
  "imports": {
    "@ursamu/ursamu": "jsr:@ursamu/ursamu@^2.3.0",
    "@ursamu/jobs-plugin": "https://raw.githubusercontent.com/UrsaMU/jobs-plugin/v1.3.0/mod.ts",
    "@ursamu/jobs-plugin/hooks": "https://raw.githubusercontent.com/UrsaMU/jobs-plugin/v1.3.0/src/hooks.ts",
    "@ursamu/jobs-plugin/types": "https://raw.githubusercontent.com/UrsaMU/jobs-plugin/v1.3.0/src/types.ts",
    "@ursamu/ursamu/chargen": "jsr:@ursamu/ursamu@^2.3.0/chargen",
    "@ursamu/ursamu/channels": "jsr:@ursamu/ursamu@^2.3.0/channels",
    "@std/assert": "jsr:@std/assert@^0.224.0",
